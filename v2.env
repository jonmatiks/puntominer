# The defaults `./v2` runs with. The environment and any typed flag beat
# everything here. `./v2` passes --mode stratum and --pool-protocol v2 on its
# own line, because those define the script rather than being defaults of it.

# The one pool known to serve V2, as its own connect panel publishes it —
# scheme, host, port and authority key in the single string a pool hands out.
# Named here rather than in `constants.rs`, where MINER_POOL is deliberately
# empty: a miner that connects somewhere out of the box is a network-visible
# action taken without being asked, and asking is what running `./v2` is.
MINER_POOL=stratum2+tcp://stratum.puntohunter.com:3334/9bXjRXap8aHiDek6TrGe6mYqLiwMzpwmfbsy41yY9c5ED91Pza8

# Where the pool pays, and the <address> half of the <address>.<worker> name
# it credits shares to. A mainnet address, because the pool above is a
# mainnet one. The second argument to `./v2` beats it, which is how a local
# pool on regtest gets an address of its own.
MINER_ADDRESS=bc1qa0wd8gy8vtgj3vs2e5emzv7lnmfdf9e8nfq8ug

# The <worker> half, which is what tells two machines apart on the pool's
# dashboard. Letters, digits, dashes and underscores only: a dot would reach
# the pool as another field. Empty falls back to this machine's hostname,
# which is the one to want when this file is shared between machines.
MINER_POOL_WORKER=puntominer

# The hashrate to claim the pool will see, in hashes a second.
#
# Change it alongside --device, which this file cannot know about: on cpu alone
# this hardware does about a third of it, and a claim off by 2x just costs the
# pool's vardiff a few minutes to correct.
MINER_POOL_HASHRATE=2000000000

# How hard each CPU search thread works, 1 to 100: a duty cycle, hashing for
# that share of every window and sleeping the rest. 75 is the compiled-in
# default, written out so that it is one edit away. Lower it to keep the
# machine usable; it throttles the CPU search only, and the GPU half of a
# hybrid run is untouched by it.
MINER_CPU_PERCENT=50

# The same for the GPU, which rests between dispatches rather than inside one:
# it works until it has used its share of a one-second window, drains what it
# has queued, and sleeps in proportion. 100 is the compiled-in default and the
# card flat out. The probe and the lottery ignore it. On gpu or hybrid,
# lowering it lowers MINER_POOL_HASHRATE's measured rate too.
MINER_GPU_PERCENT=100
