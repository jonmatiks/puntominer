# Every setting a config file may hold, in the order `./m --help` prints them.
# Copy this file, uncomment what you want to change, and run it with
#   ./m --config rig.env
# The environment and any flag beat what a file says. Every line here is
# commented out, so this file as it stands changes nothing.
#
# One KEY=VALUE per line, split at the first `=`. Quote a value containing a
# space with '...' or "...". `$`, backticks, backslashes and trailing comments
# are refused. Booleans are 1/0, true/false, yes/no or on/off. A blank value
# means the default is empty, or that it is decided at startup or specific to
# one machine; `./m --help` says which. MINER_CONFIG is not listed, because a
# file cannot name another file.

# Chain to work against: main, testnet4, signet or regtest
# MINER_CHAIN=main

# What the run does: mine, bench, probe, watch, rejections, reorg, validate,
# lottery or stratum
# MINER_MODE=mine

# Blocks to mine before stopping; 0 runs until Ctrl-C
# MINER_BLOCKS=0

# Where the coinbase pays; must decode on the chain in use
# MINER_ADDRESS=

# Where the nonce search runs: cpu, gpu or hybrid (both at once)
# MINER_DEVICE=gpu

# CPU search threads
# MINER_WORKERS=

# Duty cycle per search thread, 1 to 100; the CPU search only
# MINER_CPU_PERCENT=75

# Which implementation walks the nonce space: auto, naive, portable, sha-ni,
# rustcrypto or rustcrypto-naive
# MINER_HASHER=auto

# GPU invocations per dispatch
# MINER_GPU_LANES=262144

# Nonces each GPU lane walks per dispatch
# MINER_GPU_NONCES=256

# Dispatches in flight; 1 submits and waits
# MINER_GPU_PIPELINE=2

# Duty cycle of the GPU, 1 to 100, resting between dispatches; the block and
# share searches only
# MINER_GPU_PERCENT=100

# Winners one GPU dispatch may record
# MINER_GPU_CAPACITY=4096

# Compact target to grind to instead of the template's, which may only be
# harder; empty uses the template's
# MINER_BITS=

# Where the extranonce walk begins: auto, a decimal u64, or a 0x-prefixed hex
# one
# MINER_EXTRANONCE_START=0

# Seconds a template may be ground before it is refetched; 0 waits for the
# longpoll
# MINER_TEMPLATE_SECONDS=0

# Mine the template a longpoll answers with, rather than refetching it
# MINER_PREFETCH=true

# Roll the template's free version bits on the GPU, two versions per nonce
# (AsicBoost); the solo block search only
# MINER_TEMPLATE_VERSION_ROLLING=true

# Duration of a benchmark run, in seconds
# MINER_BENCH_SECONDS=10

# Bitcoin Core's datadir, which is where the RPC cookie is read from
# MINER_BITCOIND_DATADIR=

# Append-only log destination
# MINER_LOG=results/log

# host:port of a Stratum pool, or a stratum+tcp:// or stratum2+tcp:// URL.
# Empty means off, and there is no default pool
# MINER_POOL=

# The whole worker name to authorize as; empty builds it from MINER_ADDRESS and
# MINER_POOL_WORKER
# MINER_POOL_USER=

# The <worker> in <address>.<worker>; letters, digits, dashes and underscores
# only. Empty falls back to this machine's hostname
# MINER_POOL_WORKER=puntominer

# The password field, which on a solo pool is a difficulty request rather than
# a credential
# MINER_POOL_PASS=d=1

# Share difficulty to ask for: a request under v1, a floor under v2
# MINER_POOL_DIFFICULTY=1

# User agent announced in mining.subscribe
# MINER_POOL_AGENT=puntominer/0.1

# Pause before reconnecting; a dropped socket is normal, not fatal
# MINER_POOL_RECONNECT_SECONDS=5

# Which protocol the pool speaks: v1 or v2. Cannot be discovered, so a wrong
# guess is a hang; a stratum2+tcp:// URL in MINER_POOL says it instead
# MINER_POOL_PROTOCOL=v1

# The Stratum V2 pool authority key to pin, as base58check or 64 hex
# characters. Empty refuses any pool that is not on the loopback; skip connects
# without verifying the certificate
# MINER_POOL_AUTHORITY=

# Hash rate to claim in the Stratum V2 channel open, in h/s; 0 claims nothing
# and takes the pool's default difficulty
# MINER_POOL_HASHRATE=0

# File to record every Stratum V2 frame to, in plaintext hex; empty records
# nothing. V2 only
# MINER_POOL_CAPTURE=

# BIP310 version rolling: auto, off, or force (loopback pools only)
# MINER_VERSION_ROLLING=auto
